# ============================================
# 律法先锋 - 环境变量配置
# ============================================
# 请填入您的API密钥信息

# DeepSeek AI配置
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 得理法搜API配置
DELILEGAL_BASE_URL=https://openapi.delilegal.com
DELILEGAL_APP_ID=your-app-id
DELILEGAL_SECRET=your-secret
DELILEGAL_API_KEY=your-api-key

# 腾讯元器智能体配置
TENCENT_YUANQI_BASE_URL=https://api.yuanqi.tencent.com
TENCENT_YUANQI_ASSISTANT_ID=your-assistant-id
TENCENT_YUANQI_TOKEN=your-token

# 小梨AI配置
XIAOLI_API_BASE_URL=https://api.xiaoli.ai
XIAOLI_API_KEY=your-xiaoli-api-key
XIAOLI_API_MODEL=xiaoli-legal

# 数据库配置（Docker本地）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xiaoli_legal
DB_USERNAME=xiaoli
DB_PASSWORD=Xiaoli@2024

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Nacos配置
NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_NAMESPACE=public
NACOS_GROUP=xiaoli-legal

# Milvus向量数据库配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
