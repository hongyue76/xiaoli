# 设置默认行为
* text=auto

# 源代码文件
*.java text
*.js text
*.jsx text
*.ts text
*.tsx text
*.xml text
*.yml text
*.yaml text
*.properties text
*.md text
*.json text
*.css text
*.html text
*.sql text

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.jar binary
*.war binary
*.ear binary

# 行尾规范化
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
